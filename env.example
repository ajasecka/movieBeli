# Copy this file to  secrets/.env  and fill in your TMDB credential.
# The secrets/ folder is gitignored, so your key never gets committed.
#
#   cp env.example secrets/.env
#   # then edit secrets/.env and paste your token/key below

# Preferred: TMDB v4 "API Read Access Token" (a long JWT string).
# Get it at https://www.themoviedb.org/settings/api  ->  "API Read Access Token".
TMDB_ACCESS_TOKEN=

# OR the classic v3 API key. Provide exactly one of the two.
TMDB_API_KEY=

# ---- Optional overrides (sensible defaults shown) ----
# DATABASE_URL=postgresql+psycopg2://moviebeli:moviebeli@localhost:5432/moviebeli
# PORT=8000
# HOST=0.0.0.0
# EXPORT_CHECK_INTERVAL=1800   # how often (sec) the scheduler checks for a fresh daily export
